# Database configuration
DATABASE_URL=postgresql://sentinel_user:sentinel_pass@db:5432/sentinel_db

# Redis configuration
REDIS_URL=redis://redis:6379/0

# Rate limiting defaults
BASE_RATE_LIMIT=100
TOKEN_BUCKET_CAPACITY=100
REFILL_RATE_SECS=60.0

# Risk Thresholds
RISK_THRESHOLD_THROTTLE=30
RISK_THRESHOLD_HIGH_THROTTLE=60
RISK_THRESHOLD_SEVERE_THROTTLE=80
RISK_THRESHOLD_BLOCK=95

# ML Settings
ANOMALY_DETECTION_INTERVAL_SECS=30
MIN_TRAINING_SAMPLES=20

# JWT/Security
SECRET_KEY=super-secret-key-for-gate-session
CORS_ORIGINS=["*"]
